{
  "name": "gitropolis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "npm run dev",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run --configLoader native --pool threads --maxWorkers 1 --no-file-parallelism",
    "test:watch": "vitest --configLoader native --pool threads --maxWorkers 1 --no-file-parallelism"
  },
  "dependencies": {
    "@tresjs/cientos": "5.9.3",
    "@tresjs/core": "5.9.3",
    "three": "^0.183.0",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.0"
  }
}
